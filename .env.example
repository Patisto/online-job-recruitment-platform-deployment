BACKEND_IMAGE_REPOSITORY=ghcr.io/codeKaren777/online-job-recruitment-platform-backend
BACKEND_IMAGE_TAG=1.0.0

POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_BOOTSTRAP_DATABASE_PASSWORD
POSTGRES_RUNTIME_USER=recruitment_app
POSTGRES_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_DATABASE_PASSWORD

JWT_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
JWT_ISSUER=groupcc2-recruitment
JWT_AUDIENCE=groupcc2-api

# Set only for the first startup of an empty database, then remove both values.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

MINIO_ROOT_USER=REPLACE_WITH_MINIO_ADMIN_NAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_ADMIN_PASSWORD
PROFILE_STORAGE_ENABLED=true
PROFILE_STORAGE_BUCKET=recruitment-documents
PROFILE_STORAGE_ACCESS_KEY=REPLACE_WITH_DOCUMENT_SERVICE_ACCESS_KEY
PROFILE_STORAGE_SECRET_KEY=REPLACE_WITH_RANDOM_DOCUMENT_SERVICE_SECRET
PROFILE_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
PROFILE_DOWNLOAD_SECONDS=120

APP_MAIL_ENABLED=false
APP_MAIL_FROM=
APP_MAIL_POLL_INTERVAL_MS=30000
PASSWORD_RESET_URL=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true

# Keep local API documentation enabled only when needed.
SPRING_PROFILES_ACTIVE=local
